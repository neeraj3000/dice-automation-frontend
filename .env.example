# ==============================================================================
# Apply2Hire (A2H) Frontend Configuration Template
# Copy this file to .env and adjust values for your environment.
# Note: Variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER place sensitive private server-side secrets into this file!
# ==============================================================================

# Backend API base URL
# In development, usually points to the local backend proxy or server
VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth Client ID (optional, matches GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=
